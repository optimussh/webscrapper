{
  "name": "webscrapper",
  "version": "1.0.0",
  "private": true,
  "description": "Site crawler with structure analysis, data extraction, and ZIP export",
  "scripts": {
    "dev": "next dev -p 5900",
    "build": "next build",
    "start": "next start -p 5900",
    "crawl-job": "tsx src/crawler/run-job.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "echo Optional: npx playwright install chromium"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "crawlee": "^3.17.0",
    "jszip": "^3.10.1",
    "next": "^15.5.20",
    "playwright": "^1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.23.1",
    "typescript": "^5.8.2"
  }
}
